{
  "env": {
    "node": true,
    "es2021": true,
    "jest": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest"
  },
  "rules": {
    "no-console": "off"
  },
  "overrides": [
    {
      "files": [
        "public/**/*.js"
      ],
      "env": {
        "browser": true,
        "node": false
      }
    }
  ]
}
